# Local read-only Kalshi market-data access. Keep real values only in .env.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY=

# Current public API/WebSocket hosts.
KALSHI_API_BASE=https://external-api.kalshi.com/trade-api/v2
KALSHI_WS_URL=wss://external-api-ws.kalshi.com/trade-api/ws/v2
POLYMARKET_API_BASE=https://gamma-api.polymarket.com
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com/markets?id={}
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
